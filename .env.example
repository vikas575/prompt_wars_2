# Election Process Education Assistant – Environment Variables
# Copy this file to .env and fill in your real API keys.
# NEVER commit .env to version control.

# ─── Firebase ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Google APIs ──────────────────────────────────────────────────────────
# Used for Translate, Text-to-Speech, and Maps
VITE_GOOGLE_TRANSLATE_API_KEY=your_translate_api_key_here
VITE_GOOGLE_TTS_API_KEY=your_tts_api_key_here
VITE_GOOGLE_MAPS_API_KEY=your_maps_api_key_here

# ─── App Config ───────────────────────────────────────────────────────────
VITE_APP_ENV=development
