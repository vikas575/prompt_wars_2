// firestore.rules
/**
 * Firebase Firestore Security Rules for Election Process Education Assistant.
 *
 * Security model:
 * - Users can only read and write their own documents (uid-scoped)
 * - Public read allowed for static election data (questions, myths, timeline)
 * - No write access to public collections from the client
 * - Rate limiting enforced at document creation level
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isValidScore(score) {
      return score is int && score >= 0 && score <= 100;
    }

    function hasRequiredUserFields() {
      return request.resource.data.keys().hasAll(['uid', 'country', 'preferredLanguage', 'lastActive']);
    }

    // ── User Profiles ────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && hasRequiredUserFields();
      allow update: if isOwner(uid) && hasRequiredUserFields();
      allow delete: if false; // Never allow client-side deletion
    }

    // ── Quiz Sessions ────────────────────────────────────────────────────
    match /quizSessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.uid == request.auth.uid;
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && isValidScore(request.resource.data.score)
        && request.resource.data.completedAt is int;
      allow update: if false; // Sessions are immutable once written
      allow delete: if false;
    }

    // ── Civic Readiness Scores ────────────────────────────────────────────
    match /civicScores/{uid} {
      allow read: if isOwner(uid);
      allow write: if isOwner(uid)
        && isValidScore(request.resource.data.overallScore);
    }

    // ── Public Election Data (read-only from client) ──────────────────────
    match /electionData/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /questions/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    match /myths/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // ── Default deny ─────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
